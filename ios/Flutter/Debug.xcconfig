#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// google_mobile_ads' framework module imports GoogleMobileAds_Beta.h, a
// header the Google-Mobile-Ads-SDK xcframework ships but doesn't declare in
// its module maps. Xcode's explicit-modules build treats that as a hard
// error even with CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES set
// on the pod target alone, so set both here too, for the Runner target.
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES
CLANG_ENABLE_EXPLICIT_MODULES = NO
SWIFT_ENABLE_EXPLICIT_MODULES = NO
